# maj$q — copy to .env and fill in what you have.
#
# A fork with NOTHING filled in still runs: set FESTRO_MOCK=1 and the bundled
# fixture catalog answers every search offline. Add keys as you get them.

# ---------------------------------------------------------------- Festro ----
# The public catalog. Read-only, anonymous, rate limited to 60 req/min per IP.
FESTRO_API_BASE=https://api.festro.com
FESTRO_SITE_BASE=https://festro.com
FESTRO_MARKET=montreal

# Serve the bundled fixtures instead of calling Festro. Set to 1 to run offline.
FESTRO_MOCK=0

# Optional. Registered third-party client credentials. Not needed today — the
# catalog answers anonymously — but sent when present so maj$q keeps working
# once Festro's client trust gate moves from monitor to enforce.
FESTRO_CLIENT_ID=
FESTRO_CLIENT_SECRET=

# ----------------------------------------------------------------- Model ----
OPENAI_API_KEY=
MAJSQ_MODEL=gpt-5

# -------------------------------------------------------------- Telegram ----
# From @BotFather. Turn privacy mode OFF so the bot can read group messages,
# and run /setdomain with your majsqweb URL for the login button.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Any long random string. Telegram echoes it as X-Telegram-Bot-Api-Secret-Token
# on every webhook POST; the webhook refuses updates without it.
TELEGRAM_WEBHOOK_SECRET=

# ----------------------------------------------------------------- Agent ----
DJANGO_SECRET_KEY=dev-only-insecure-key-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*
# Postgres in a deployed environment; blank uses SQLite so a clone just works.
DATABASE_URL=

# Shared secret between the web app's server and the agent. The browser never
# holds it. Generate with: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
MAJSQ_SERVICE_SECRET=
# Set to 1 to let unauthenticated curl hit /agui/ while developing locally.
MAJSQ_OPEN_AGUI=1
MAJSQ_WEB_URL=http://localhost:3000

# ------------------------------------------------------------------- Web ----
# (web/.env.local)
MAJSQ_AGENT_URL=http://localhost:8000
# Optional Copilot Cloud key. Leave blank to use the self-hosted runtime route,
# which only needs OPENAI_API_KEY.
NEXT_PUBLIC_COPILOT_CLOUD_PUBLIC_API_KEY=
